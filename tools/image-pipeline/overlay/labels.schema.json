{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajamix.local/schemas/image-label-record.json",
  "title": "AJAMIX script-agnostic image label record",
  "type": "object",
  "required": ["version", "baseArtwork", "canvas", "labels"],
  "properties": {
    "version": { "const": "1.0" },
    "baseArtwork": { "type": "string", "description": "Path or immutable content-addressed ID; never bake labels into this asset." },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "safeAreas": { "type": "array", "items": { "$ref": "#/$defs/box" } },
    "labels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } }
  },
  "$defs": {
    "box": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "line": { "type": "object", "required": ["x1", "y1", "x2", "y2"], "properties": { "x1": { "type": "number" }, "y1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" }, "arrow": { "type": "boolean" } } },
    "label": {
      "type": "object",
      "required": ["id", "mode", "box", "font", "lines"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "enum": ["latin", "ajami", "bilingual"] },
        "box": { "$ref": "#/$defs/box" },
        "font": { "type": "object", "required": ["latinFamily", "ajamiFamily", "size"], "properties": { "latinFamily": { "type": "string" }, "ajamiFamily": { "type": "string" }, "size": { "type": "number", "minimum": 8 }, "lineHeight": { "type": "number", "minimum": 1 } } },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "object", "required": ["script", "text"], "properties": { "script": { "enum": ["latin", "ajami", "math"] }, "text": { "type": "string" }, "direction": { "enum": ["ltr", "rtl"] }, "validated": { "type": "boolean" }, "columnLines": { "type": "array", "items": { "type": "string" } } } } },
        "callout": { "$ref": "#/$defs/line" },
        "background": { "type": "string" }, "foreground": { "type": "string" }, "mobileSafe": { "type": "boolean" }
      }
    }
  }
}
