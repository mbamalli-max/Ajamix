{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"node -e '\nconst fs=require(\\\"fs\\\"),crypto=require(\\\"crypto\\\");\nconst m1=JSON.parse(fs.readFileSync(\\\"tools/p3-batch/p3-socs-pilot.json\\\"));\nconst m2=JSON.parse(fs.readFileSync(\\\"tools/p3-batch/p3-socs-complete.json\\\"));\nconst all=[...m1,...m2], ref=Object.keys(m1[0]); const errors=[];\nfor(const m of m2){\n if(JSON.stringify(Object.keys(m))\"'!==JSON.stringify(ref)) errors.push(`${m.id}: schema/order`);\n const wc=m.textExplanationHa.trim().split(/'\"\\\\s+/).length; if(wc<120||wc>170)errors.push(\"'`${m.id}: words ${wc}`);\n if(m.microPauses.length!==2||m.quizQuestions.length!==5)errors.push(`${m.id}: item counts`);\n if(m.titleAjami!==null||m.textExplanationAjami!==null||m.ajami_validated!==false)errors.push(`${m.id}: Ajami`);\n if(m.audioFile!==`audio/${m.id}.mp3`||m.imageCard!==`images/${m.id}.png`)errors.push(`${m.id}: paths`);\n m.microPauses.forEach((p,i)=>{if(!m.audioScript.includes(`[PAUSE ${i+1}] ${p.questionHa}`))errors.push(`${m.id}: pause ${i+1} mismatch`);if(p.options.filter(x=>x===p.correctAnswer).length!==1)errors.push(`${m.id}: pause ${i+1} answer count`)});\n m.quizQuestions.forEach((q,i)=>{if(q.distractorFormulas.includes(q.answerFormula))errors.push(`${m.id}: Q${i+1} answer in distractors`);if(q.distractorFormulas.length!==3)errors.push(`${m.id}: Q${i+1} distractor count`);if(!(m.textExplanationHa+m.audioScript).includes(q.answerFormula))errors.push(`${m.id}: Q${i+1} answer not literal in teaching`);if(JSON.stringify(q.variableRanges)!==JSON.stringify({a:{min:0,max:0},b:{min:0,max:0}}))errors.push(`${m.id}: Q${i+1} ranges`)});\n}\nconst ids=all.map(x=>x.id), nums=all.map(x=>x.moduleNumber);\nif(new Set(ids).size!==15)errors.push(\"full-band duplicate ID\");\nif(JSON.stringify(nums)!==JSON.stringify([...Array(15)].map((_,i)=>i+1)))errors.push(\"full-band sequence\");\nconsole.log(`schema keys=${ref.length}; M2 modules=${m2.length}