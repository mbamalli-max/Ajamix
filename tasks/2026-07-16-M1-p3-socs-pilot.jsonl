{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"node -e '\nconst fs=require(\\\"fs\\\");\nconst crypto=require(\\\"crypto\\\");\nconst mods=JSON.parse(fs.readFileSync(\\\"tools/p3-batch/p3-socs-pilot.json\\\",\\\"utf8\\\"));\nconst manifest=JSON.parse(fs.readFileSync(\\\"tools/image-manifest/p3-socs-image-manifest.json\\\",\\\"utf8\\\"));\nconst keys=[\\\"id\\\",\\\"gradeband\\\",\\\"subject\\\",\\\"subjectHa\\\",\\\"moduleNumber\\\",\\\"titleEn\\\",\\\"titleHa\\\",\\\"titleAjami\\\",\\\"ajami_validated\\\",\\\"textExplanationHa\\\",\\\"textExplanationAjami\\\",\\\"audioScript\\\",\\\"audioFile\\\",\\\"imageCard\\\",\\\"microPauses\\\",\\\"quizQuestions\\\",\\\"track\\\",\\\"targetAudience\\\",\\\"gapTeaser\\\",\\\"chainNext\\\",\\\"isChainLeaf\\\",\\\"useTodayPrompt\\\"];\nconst mkeys=[\\\"id\\\",\\\"imagePath\\\",\\\"titleEn\\\",\\\"titleHa\\\",\\\"type\\\",\\\"depictEn\\\",\\\"labelsHa\\\",\\\"safetyNote\\\"];\nlet errors=[];\nif(mods.length\"'!==6) errors.push(`module count ${mods.length}`);\nconst ids=mods.map(m=>m.id);\nif(new Set(ids).size!==ids.length) errors.push(\"duplicate IDs\");\nfor(let i=0;i<mods.length;i++){\n const m=mods[i], where=m.id;\n const got=Object.keys(m);\n if(JSON.stringify(got)!==JSON.stringify(keys)) errors.push(`${where}: key/order mismatch: ${got.join(\",\")}`);\n if(m.id!==`p3-socs-${String(i+1).padStart(2,\"0\")}`||m.moduleNumber!==i+1) errors.push(`${where}: sequence mismatch`);\n const wc=m.textExplanationHa.trim().split(/'\"\\\\s+/u).length;\n if(wc<120||wc>170) errors.push(\"'`${where}: word count ${wc}`);\n if(m.microPauses.length!==2||m.quizQuestions.length!==5) errors.push(`${where}: pause/quiz count`);\n for(let p=0;p<2;p++){\n  const marker=`[PAUSE ${p+1}] ${m.microPauses[p].questionHa}`;\n  if(!m.audioScript.includes(marker)) errors.push(`${where}: pause ${p+1} text mismatch`);\n  if(m.microPauses[p].options.filter(x=>x===m.microPauses[p].correctAnswer).length!==1) errors.