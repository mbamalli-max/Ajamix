   \"track\": \"formal\",\n    \"targetAudience\": \"youth\",\n    \"gapTeaser\": null,\n    \"chainNext\": null,\n    \"isChainLeaf\": true,\n    \"useTodayPrompt\": null,\n    \"segments\": [\n      {\n        \"index\": 1,\n        \"audioScript\": \"Yau zamu rubuta lambobi 1-5. Lamba 1: sanda tsaye. Ka zana. Lamba 2: wuyan agwagwa. Ka zana. Lamba 3: kurvature biyu. Ka zana. Lamba 4: sanda da layi. Ka zana. Lamba 5: tudun kai da ciki. Ka zana. Rubuta lamba 3 da kanka.\",\n        \"text\": {\n          \"ha\": \"Rubuta lambobi yana nufin zana su a takarda. A wannan darasi, za mu koyi rubuta lambobi daga ɗaya zuwa biyar. Fara da lamba ɗaya – zana sanda tsaye guda ɗaya. Biyu – kamar wuyan agwagwa. Uku – lambobi uku suna da kurvature biyu. Huɗu – kamar sararin samaniya da sanda. \",\n          \"ajami\": null\n        },\n        \"audioFile\": \"audio/n1-maths-02-01.mp3\",\n        \"gate\": \"quiz\"\n      },\n      {\n        \"index\": 2,\n        \"audioScript\": \"Ci gaba. Ka rubuta 1 zuwa 5 a jere. Rubuta lamba 5.\",\n        \"text\": {\n          \"ha\": \"Biyar – kamar 'S' mai tudun kai. \",\n          \"ajami\": null\n        },\n        \"audioFile\": \"audio/n1-maths-02-02.mp3\",\n        \"gate\": \"quiz\"\n      },\n      {\n        \"index\": 3,\n        \"audioScript\": \"Aiki nagari! Yau ka koyi rubuta 1-5.\",\n        \"text\": {\n          \"ha\": \"Ka yi amfani da yatsa ka bi hanyar rubutu.\",\n          \"ajami\": null\n        },\n        \"audioFile\": \"audio/n1-maths-02-03.mp3\",\n        \"gate\": null\n      }\n    ]\n  }\n]\n","exit_code":0,"status":"completed"}}
