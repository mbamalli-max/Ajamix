e}: expected ${pattern}, got ${JSON.stringify(issues)}`);\n    30\t  console.log(`PASS ${name}`);\n    31\t}\n    32\t\n    33\tconst formalPath = \"audio/p3-maths-04.mp3\";\n    34\texpectIssue(\"formal 149.9s fails\", 149.9, formalPath, /149\\.9s — formal module audio must be 150-330s\\./);\n    35\texpectPass(\"formal 150s passes\", 150, formalPath);\n    36\texpectPass(\"formal 330s passes\", 330, formalPath);\n    37\texpectIssue(\"formal 331s fails\", 331, formalPath, /331\\.0s — formal module audio must be 150-330s\\./);\n    38\t\n    39\tconst formalSegmentPath = \"audio/p3-socs-01-01.mp3\";\n    40\texpectIssue(\"formal segment 2.9s fails\", 2.9, formalSegmentPath, /p3-socs-01-01\\.mp3: 2\\.9s — formal segment clips must be 3-90s\\./);\n    41\texpectPass(\"formal segment 3s passes\", 3, formalSegmentPath);\n    42\texpectPass(\"formal segment 90s passes\", 90, formalSegmentPath);\n    43\texpectIssue(\"formal segment 90.1s fails\", 90.1, formalSegmentPath, /p3-socs-01-01\\.mp3: 90\\.1s — formal segment clips must be 3-90s\\./);\n    44\tassert.equal(classifyAudioPath(formalSegmentPath).track, \"formal segment clips\", \"formal segment path classifies as a formal segment\");\n    45\tassert.equal(classifyAudioPath(formalPath).track, \"formal module audio\", \"legacy formal path remains legacy formal\");\n    46\tconsole.log(\"PASS formal segment and legacy formal paths classify correctly\");\n    47\t\n    48\tconst adultPaths = {\n    49\t  vocational: \"audio/vocational/V01-01.mp3\",\n    50\t  falsafa: \"audio/falsafa/FL01-01.mp3\",\n    51\t  criticalThinking: \"audio/critical-thinking/CT01-03.mp3\",\n    52\t};\n    53\texpectIssue(\"adult 2.9s fails\", 2.9, adultPaths.criticalThinking, /CT01-03\\.mp3: 2\\.9s — adult Critical Thinking clips must be 3-40s\\./);\n    54\texpectPass(\"adult 3s passes\", 3, adultPaths.criticalThinking);\n    55\texpectPass(\"adult 40s passes\", 40, adultPaths.criticalThinking);\n    56\texpectIssue(\"adult 40.1s fails\", 40.1, adultPaths.criticalThinking, /CT01-03\\.mp3: 40\\.1s — adult Critical Thinking clips must be 3-40s\\./);\n    57\t\n    58\tfor (const [name, audioFile] of Object.entries(adultPaths)) {\n    59\t  const classification = classifyAudioPath(audioFile);\n    60\t  assert(!classification.error, `${name}: should classify`);\n    61\t  assert.match(classification.track, new RegExp(name === \"criticalThinking\" ? \"Critical Thinking\" : name === \"falsafa\" ? \"Falsafa\" : \"Vocational Skills\"));\n    62\t  expectPass(`${name} valid path classifies and passes`, 10, audioFile);\n    63\t}\n    64\t\n    65\texpectIssue(\"unknown path fails classification\", 10, \"recordings/future/F01.mp3\", /unclassifiable audio path: recordings\\/future\\/F01\\.mp3/);\n    66\texpectIssue(\"adult bitrate check still fails\", 10, adultPaths.vocational, /bitrate=96kbps/,{ bitrate: 96000 });\n    67\texpectIssue(\"adult mono check still fails\", 10, adultPaths.vocational, /channels=2, expected 1 \\(mono\\)/,{ channels: 2 });\n    68\texpectIssue(\"adult filename check still fails\", 10, \"audio/vocational/V01-01.wav\", /filename must end in \\.mp3/);\n    69\t\n    70\tconst worklist = buildWorklist(content);\n    71\tconst formalSegmentTargets = worklist.filter((target) => target.kind === \"formal-segment\");\n    72\tconst legacyFormalTargets = worklist.filter((target) => target.kind === \"formal\");\n    73\tconst adultTargets = worklist.filter((target) => target.kind === \"adult-card\");\n    74\tassert.equal(formalSegmentTargets.length, 1077, \"all formal segment targets are enumerated\");\n    75\tassert.equal(legacyFormalTargets.length, 0, \"segmented formal modules do not retain legacy worklist entries\");\n    76\tassert.equal(adultTargets.length, 150, \"all adult card targets are enumerated\");\n    77\tassert.equal(new Set(adultTargets.map((target) => target.id)).size, 150, \"adult card IDs are distinct\");\n    78\tconsole.log(\"PASS worklist enumerates 1,077 formal segment