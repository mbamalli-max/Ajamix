/vocational/\", track: \"adult Vocational Skills clips\" },\n    36\t  { prefix: \"audio/falsafa/\", track: \"adult Falsafa clips\" },\n    37\t  { prefix: \"audio/critical-thinking/\", track: \"adult Critical Thinking clips\" },\n    38\t];\n    39\t\n    40\texport function normalizeAudioPath(audioFile) {\n    41\t  return String(audioFile || \"\").replaceAll(\"\\\\\", \"/\").replace(/^\\.\\/+/, \"\");\n    42\t}\n    43\t\n    44\texport function classifyAudioPath(audioFile) {\n    45\t  const normalizedPath = normalizeAudioPath(audioFile);\n    46\t  const adultMatch = ADULT_AUDIO_PREFIXES.find(({ prefix }) => normalizedPath.startsWith(prefix));\n    47\t  if (adultMatch) {\n    48\t    return {\n    49\t      normalizedPath,\n    50\t      track: adultMatch.track,\n    51\t      minSec: SPEC.adultDurationMinSec,\n    52\t      maxSec: SPEC.adultDurationMaxSec,\n    53\t    };\n    54\t  }\n    55\t\n    56\t  // A formal segment uses the registered formal module ID plus -NN. This is\n    57\t  // intentionally checked before the legacy direct-child formal path below.\n    58\t  const segmentMatch = /^audio\\/(.+)-(\\d{2})\\.mp3$/.exec(normalizedPath);\n    59\t  if (segmentMatch && FORMAL_MODULE_IDS.has(segmentMatch[1]) && Number(segmentMatch[2]) >= 1 && Number(segmentMatch[2]) <= 3) {\n    60\t    return {\n    61\t      normalizedPath,\n    62\t      track: \"formal segment clips\",\n    63\t      minSec: SPEC.formalSegmentDurationMinSec,\n    64\t      maxSec: SPEC.formalSegmentDurationMaxSec,\n    65\t    };\n    66\t  }\n    67\t\n    68\t  // Formal recordings are direct children of audio/; adult recordings use a named subfolder.\n    69\t  if (/^audio\\/[^/]+$/.test(normalizedPath)) {\n    70\t    return {\n    71\t      normalizedPath,\n    72\t      track: \"formal module audio\",\n    73\t      minSec: SPEC.formalDurationMinSec,\n    74\t      maxSec: SPEC.formalDurationMaxSec,\n    75\t    };\n    76\t  }\n    77\t\n    78\t  return {\n    79\t    normalizedPath,\n    80\t    error: `unclassifiable audio path: ${normalizedPath || \"(empty path)\"}`,\n    81\t  };\n    82\t}\n    83\t\n    84\texport function buildWorklist(sourceContent) {\n    85\t  const formalTargets = sourceContent.modules\n    86\t    .filter((module) => module.track === \"formal\")\n    87\t    .flatMap((module) => Array.isArray(module.segments)\n    88\t      ? module.segments.map((segment) => ({\n    89\t        id: `${module.id}-${String(segment.index).padStart(2, \"0\")}`,\n    90\t        gradeband: module.gradeband,\n    91\t        audioFile: segment.audioFile,\n    92\t        kind: \"formal-segment\",\n    93\t      }))\n    94\t      : (module.audioScript && module.audioFile ? [{\n    95\t        id: module.id,\n    96\t        gradeband: module.gradeband,\n    97\t        audioFile: module.audioFile,\n    98\t        kind: \"formal\",\n    99\t      }] : []));\n   100\t\n   101\t  const adultTargets = sourceContent.modules\n   102\t    .filter((module) => module.track === \"vocational\" && module.gradeband === \"adult\")\n   103\t    .flatMap((module) => module.lessons\n   104\t      .map((lesson, index) => ({ lesson, index }))\n   105\t      .filter(({ lesson }) => typeof lesson.audioFile === \"string\" && lesson.audioFile.trim())\n   106\t      .map(({ lesson, index }) => ({\n   107\t        id: `${module.id}-${String(index + 1).padStart(2, \"0\")}`,\n   108\t        gradeband: module.gradeband,\n   109\t        audioFile: lesson.audioFile,\n   110\t        kind: \"adult-card\",\n   111\t      })));\n   112\t\n   113\t  return [...formalTargets, ...adultTargets];\n   114\t}\n   115\t\n   116\tasync function probe(filePath) {\n   117\t  const { stdout } = await execFileAsync(\"ffprobe\", [\n   118\t    \"-v\", \"error\",\n   119\t    \"-print_format\", \"json\",\n   120\t    \"-show_format\",\n   121\t    \"-show_streams\",\n   122\t    filePath,\n   123\t  ]);\n   124\t  return JSON.parse(stdout);\n   125\t}\n   126\t\n   127\texport function checkOne(info, audioFile, stat = fs.statSync(audioFile)) {\n   128\t  const issues = [];\n   129\t  const classification = classifyAudioPath(audioFile);\n   130\t  if (classification.error) issues.push(classification.error);\n   131\t  const audioStream = (info.streams || []).find((s) => s.codec_type === \"audio\");\n   132\t  if (!audioStream) {\n   133\t    issues.push(\"no audio stream found\");\n   134\t    return issues;\n   135\t  }\n   136\t  const formatName = (info.format?.format_name || \"\").toLowerCase();\n   137\t  if (!formatName.includes(\"mp3\")) {\n   138\t    issues.push(`format is \"${info.format?.format_name}\", expected mp3`);\n   139\t  }\n   140\t  if (!classification.normalizedPath.toLowerCase().endsWith(\".mp3\")) {\n   141\t    issues.push(`${classification.normalizedPath}: filename must end in .mp3`);\n   142\t  }\n   143\t  if (audioStream.channels !== SPEC.channels) {\n   144\t    issues.push(`channels=${audioStream.channels}, expected ${SPEC.channels} (mono)`);\n   145\t  }\n   146\t  const bitrateKbps = Math.round(Number(info.format?.bit_rate || audioStream.bit_rate || 0) / 1000);\n   147\t  if (bitrateKbps === 0) {\n   148\t    issues.push(\"could not determine bitrate\");\n   149\t  } else if (Math.abs(bitrateKbps - SPEC.bitrateKbpsTarget) > SPEC.bitrateKbpsTolerance) {\n   150\t    issues.push(`bitrate=${bitrateKbps}kbps, expected ~${SPEC.bitrateKbpsTarget}kbps (±${SPEC.bitrateKbpsTolerance}kbps)`);\n   151\t  }\n   152\t  const durationSec = Number(info.format?.duration || 0);\n   153\t  if (durationSec === 0) {\n   154\t    issues.push(\"could not determine duration\");\n   155\t  } else if (!classification.error && (durationSec < classification.minSec || durationSec > classification.maxSec)) {\n   156\t    issues.push(`${path.posix.basename(classification.normalizedPath)}: ${durationSec.toFixed(1)}s — ${classification.track} must be ${classification.minSec}-${classification.maxSec}s.`);\n   157\t  }\n   158\t  if (stat.size === 0) {\n   159\t    issues.push(\"file is zero bytes\");\n   160\t  }\n   161\t  return issues;\n   162\t}\n   163\t\n   164\tasync function main() {\n   165\t  const targets = buildWorklist(content);\n   166\t  const filtered = BAND_FILTER ? targets.filter((target) => target.gradeband === BAND_FILTER) : targets;\n   167\t\n   168\t  const results = { checked: 0, missing: [], passed: [], flagged: [] };\n   169\t\n   170\t  for (const target of filtered) {\n   171\t    const normalizedPath = normalizeAudioPath(target.audioFile);\n   172\t    const relativePath = normalizedPath.startsWith(\"audio/\") ? normalizedPath.slice(\"audio/\".length) : normalizedPath;\n   173\t    const filePath = path.join(SCAN_DIR, relativePath);\n   174\t    const displayPath = normalizedPath;\n   175\t    if (!fs.existsSync(filePath)) {\n   176\t      results.missing.push(target.id);\n   177\t      continue;\n   178\t    }\n   179\t    results.checked += 1;\n   180\t    try {\n   181\t      const info = await probe(filePath);\n   182\t      const issues = checkOne(info, target.audioFile, fs.statSync(filePath));\n   183\t      if (issues.length) {\n   184\t        results.flagged.push({ id: target.id, file: displayPath, issues });\n   185\t      } else {\n   186\t        results.passed.push(target.id);\n   187\t      }\n   188\t    } catch (e) {\n   189\t      results.flagged.push({ id: target.id, file: displayPath, issues: [`ffprobe failed: ${e.message}`] });\n   190\t    }\n   191\t  }\n   192\t\n   193\t  console.log(\"=== AJAMIX audio delivery QA ===\");\n   194\t  console.log(\"scan dir:\", SCAN_DIR);\n   195\t  if (BAND_FILTER) console.log(\"band filter:\", BAND_FILTER);\n   196\t  console.log(\"audio targets expected:\", filtered.length);\n   197\t  console.log(\"files found & checked:\", results.checked);\n   198\t  console.log(\"missing (not yet delivered):\", results.missing.length);\n   199\t  console.log(\"passed spec:\", results.passed.length);\n   200\t  console.log(\"flagged (out of spec):\", results.flagged.length);\n   201\t\n   202\t  if (results.flagged.length) {\n   203\t    console.log(\"\\n-- flagged details --\");\n   204\t    for (const f of results.flagged) {\n   205\t      console.log(`${f.id} (${f.file}):`);\n   206\t      for (const issue of f.issues) console.log(\"  -\", issue);\n   207\t    }\n   208\t  }\n   209\t\n   210\t  fs.writeFileSync(\n   211\t    path.join(REPO, \"tools/audio-pipeline/_qa-report.json\"),\n   212\t    JSON.stringify(results, null, 2)\n   213\t  );\n   214\t\n   215\t  console.log(\"\\nNote: this checks technical spec only (format/channels/bitrate/duration).\");\n   216\t  console.log(\"It cannot and does not check Hausa pronunciation, accuracy, or naturalness — that is TIMSAN's review.\");\n   217\t}\n   218\t\n   219\tif (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {\n   220\t  main();\n   221\t}\n     1\t#!/usr/bin/env node\n     2\t// Almajirix content validator\n     3\t//\n     4\t// Usage:   node app/tools/validate-content.mjs [--content path/to/content.json]\n     5\t// Purpose: enforce the v3.0 dual-track schema on app/content.json before commit.\n     6\t// Exits 0 on success, 1 on any validation failure.\n     7\t//\n     8\t// Rules (from plan §4.6):\n     9\t//   1. Every module has a `track` of \"vocational\" or \"formal\".\n    10\t//   2. Every module has a `targetAudience` of \"adult\", \"youth\", or \"all\".\n    11\t//   3. Every module has either `chainNext` set to a valid sibling module id\n    12\t//      OR `isChainLeaf === true`.\n    13\t//   4. Latin learner-content fields are always required. Ajami fields are\n    14\t//      required when `ajami_validated === true`; otherwise they may be null,\n    15\t//      but any non-null Ajami value must still be a non-empty string.\n    16\t//   5. Adult vocational modules retain their complete lesson and quiz schema.\n    17\t//   6. When `chainNext` is set, `gapTeaser` is required; `useTodayPrompt` and\n    18\t//      `gapTeaserInline`, when present, must retain valid bilingual shapes.\n    19\t\n    20\timport { readFileSync } from \"node:fs\";\n    21\timport { resolve, dirname } from \"node:path\";\n    22\timport { fileURLToPath } from \"node:url\";\n    23\t\n    24\tconst here = dirname(fileURLToPath(import.meta.url));\n    25\tconst contentFlagIndex = process.argv.indexOf(\"--content\");\n    26\tconst contentPath = contentFlagIndex >= 0 && process.argv[contentFlagIndex + 1]\n    27\t  ? resolve(process.argv[contentFlagIndex + 1])\n    28\t  : resolve(here, \"..\", \"content.json\");\n    29\t\n    30\tconst ALLOWED_TRACKS = new Set([\"vocational\", \"formal\"]);\n    31\tconst ALLOWED_AUDIENCES = new Set([\"adult\", \"youth\", \"all\"]);\n    32\t\n    33\tfunction isNonEmptyString(v) {\n    34\t  return typeof v === \"string\" && v.trim().length > 0;\n    35\t}\n    36\t\n    37\tfunction validateAjamiValue(errors, where, value, ajamiValidated) {\n    38\t  if (ajamiValidated) {\n    39\t    if (!isNonEmptyString(value)) errors.push(`${where}: must be a non-empty string when ajami_validated is true.`);\n    40\t    return;\n    41\t  }\n    42\t  if (value !== null && !isNonEmptyString(value)) {\n    43\t    errors.push(`${where}: must be null or a non-empty string when ajami_validated is false.`);\n    44\t  }\n    45\t}\n    46\t\n    47\tfunction validateBilingualObject(errors, where, value, ajamiValidated, required) {\n    48\t  if (value == null) {\n    49\t    if (required) errors.push(`${where}: required object with ha + ajami fields is missing.`);\n    50\t    return;\n    51\t  }\n    52\t  if (typeof value !== \"object\" || Array.isArray(value)) {\n    53\t    errors.push(`${where}: must be an object with ha + ajami fields.`);\n    54\t    return;\n    55\t  }\n    56\t  if (!isNonEmptyString(value.ha)) errors.push(`${where}.ha: must be a non-empty string.`);\n    57\t  if (!Object.hasOwn(value, \"ajami\")) {\n    58\t    errors.push(`${where}.ajami: required field is missing.`);\n    59\t    return;\n    60\t  }\n    61\t  validateAjamiValue(errors, `${where}.ajami`, value.ajami, ajamiValidated);\n    62\t}\n    63\t\n    64\tfunction validateRootBilingualPair(errors, where, latin, ajami, ajamiValidated, hasAjamiField) {\n    65\t  if (!isNonEmptyString(latin)) errors.push(`${where}: must be a non-empty string.`);\n    66\t  if (!hasAjamiField) {\n    67\t    if (ajamiValidated) errors.push(`${where.replace(/Ha$/, \"Ajami\")}: required field is missing when ajami_validated is true.`);\n    68\t    return;\n    69\t  }\n    70\t  validateAjamiValue(errors, `${where.replace(/Ha$/, \"Ajami\")}`, ajami, ajamiValidated);\n    71\t}\n    72\t\n    73\tfunction validateQuizArray(errors, where, quiz) {\n    74\t  if (!Array.isArray(quiz) || quiz.length !== 5) {\n    75\t    errors.push(`${where}: must contain exactly five quiz items.`);\n    76\t    return;\n    77\t  }\n    78\t  for (const [index, question] of quiz.entries()) {\n    79\t    const questionWhere = `${where}[${index}]`;\n    80\t    if (!question || typeof question !== \"object\" || Array.isArray(question)) {\n    81\t      errors.push(`${questionWhere}: must be an object.`);\n    82\t      continue;\n    83\t    }\n    84\t    if (!isNonEmptyString(question.templateHa)) errors.push(`${questionWhere}.templateHa: must be a non-empty string.`);\n    85\t    if (!isNonEmptyString(question.answerFormula)) errors.push(`${questionWhere}.answerFormula: must be a non-empty string.`);\n    86\t    if (!Array.isArray(question.distractorFormulas) || question.distractorFormulas.length !== 3 || !question.distractorFormulas.every(isNonEmptyString)) {\n    87\t      errors.push(`${questionWhere}.distractorFormulas: must contain exactly three non-empty strings.`);\n    88\t    }\n    89\t    if (Array.isArray(question.distractorFormulas) && question.distractorFormulas.includes(question.answerFormula)) {\n    90\t      errors.push(`${questionWhere}: answerFormula must not appear among distractorFormulas.`);\n    91\t    }\n    92\t    const ranges = question.variableRanges;\n    93\t    if (!ranges || typeof ranges !== \"object\" || !ranges.a || !ranges.b || !Number.isFinite(ranges.a.min) || !Number.isFinite(ranges.a.max) || !Number.isFinite(ranges.b.min) || !Number.isFinite(ranges.b.max)) {\n    94\t      errors.push(`${questionWhere}.variableRanges: must contain numeric a and b min/max ranges.`);\n    95\t    }\n    96\t  }\n    97\t}\n    98\t\n    99\tfunction validateAdultVocationalModule(errors, m, where) {\n   100\t  const requiredFields = [\n   101\t    \"id\", \"gradeband\", \"subject\", \"subjectHa\", \"moduleNumber\", \"titleEn\", \"titleHa\", \"titleAjami\", \"title\",\n   102\t    \"ajami_validated\", \"summary\", \"textExplanationHa\", \"textExplanationAjami\", \"audioScript\", \"audioFile\",\n   103\t    \"imageCard\", \"lessons\", \"microPauses\", \"passingScore\", \"quiz\", \"quizQuestions\", \"track\", \"targetAudience\",\n   104\t    \"gapTeaser\", \"chainNext\", \"isChainLeaf\", \"useTodayPrompt\",\n   105\t  ];\n   106\t  for (const field of requiredFields) {\n   107\t    if (!Object.hasOwn(m, field)) errors.push(`${where}.${field}: required adult vocational field is missing.`);\n   108\t  }\n   109\t  if (m.gradeband !== \"adult\") errors.push(`${where}.gradeband: adult vocational modules must use \"adult\".`);\n   110\t  if (!isNonEmptyString(m.subject) || !isNonEmptyString(m.subjectHa) || !isNonEmptyString(m.titleEn)) {\n   111\t    errors.push(`${where}: subject, subjectHa, and titleEn must be non-empty strings.`);\n   112\t  }\n   113\t  if (!Number.isInteger(m.moduleNumber) || m.moduleNumber < 1) errors.push(`${where}.moduleNumber: must be a positive integer.`);\n   114\t  if (!Array.isArray(m.lessons) || m.lessons.length !== 5) {\n   115\t    errors.push(`${where}.lessons: must contain exactly five lessons.`);\n   116\t  } else {\n   117\t    for (const [index, lesson] of m.lessons.entries()) {\n   118\t      const lessonWhere = `${where}.lessons[${index}]`;\n   119\t      if (!lesson || typeof lesson !== \"object\" || Array.isArray(lesson) || !isNonEmptyString(lesson.type)) {\n   120\t        errors.push(`${lessonWhere}: must be a typed lesson object.`);\n   121\t        continue;\n   122\t      }\n   123\t      for (const [key, value] of Object.entries(lesson)) {\n   124\t        if (key === \"type\") continue;\n   125\t        if (key === \"audioFile\" || key === \"audioScript\") {\n   126\t          if (!isNonEmptyString(value)) errors.push(`${lessonWhere}.${key}: must be a non-empty string.`);\n   127\t          continue;\n   128\t        }\n   129\t        validateBilingualObject(errors, `${lessonWhere}.${key}`, value, m.ajami_validated, true);\n   130\t      }\n   131\t    }\n   132\t  }\n   133\t  if (!Array.isArray(m.microPauses)) errors.push(`${where}.microPauses: must be an array.`);\n   134\t  if (!Number.isFinite(m.passingScore)) errors.push(`${where}.passingScore: must be numeric.`);\n   135\t  validateQuizArray(errors, `${where}.quiz`, m.quiz);\n   136\t  validateQuizArray(errors, `${where}.quizQuestions`, m.quizQuestions);\n   137\t  if (JSON.stringify(m.quiz) !== JSON.stringify(m.quizQuestions)) errors.push(`${where}: quiz and quizQuestions must be identical.`);\n   138\t}\n   139\t\n   140\tfunction validateSegments(errors, m, where) {\n   141\t  if (!Array.isArray(m.segments) || m.segments.length !== 3) {\n   142\t    errors.push(`${where}.segments: must contain exactly three segments.`);\n   143\t    return;\n   144\t  }\n   145\t  for (const [offset, segment] of m.segments.entries()) {\n   146\t    const segmentWhere = `${where}.segments[${offset}]`;\n   147\t    if (!segment || typeof segment !== \"object\" || Array.isArray(segment)) {\n   148\t      errors.push(`${segmentWhere}: must be an object.`);\n   149\t      continue;\n   150\t    }\n   151\t    if (segment.index !== offset + 1) errors.push(`${segmentWhere}.index: must be ${offset + 1}.`);\n   152\t    if (!isNonEmptyString(segment.audioScript)) errors.push(`${segmentWhere}.audioScript: must be a non-empty string.`);\n   153\t    if (!isNonEmptyString(segment.audioFile)) errors.push(`${segmentWhere}.audioFile: must be a non-empty string.`);\n   154\t    const expectedGate = offset < 2 ? \"quiz\" : null;\n   155\t    if (segment.gate !== expectedGate) errors.push(`${segmentWhere}.gate: must be ${JSON.stringify(expectedGate)}.`);\n   156\t    if (!segment.text || typeof segment.text !== \"object\" || Array.isArray(segment.text)) {\n   157\t      errors.push(`${segmentWhere}.text: must be a bilingual object.`);\n   158\t    } else {\n   159\t      if (!isNonEmptyString(segment.text.ha)) errors.push(`${segmentWhere}.text.ha: must be a non-empty string.`);\n   160\t      if (!Object.hasOwn(segment.text, \"ajami\") || segment.text.ajami !== null) errors.push(`${segmentWhere}.text.ajami: must be null.`);\n   161\t    }\n   162\t  }\n   163\t}\n   164\t\n   165\tfunction main() {\n   166\t  let raw;\n   167\t  try {\n   168\t    raw = readFileSync(contentPath, \"utf8\");\n   169\t  } catch (err) {\n   170\t    console.error(`validate-content: could not read ${contentPath}: ${err.message}`);\n   171\t    process.exit(1);\n   172\t  }\n   173\t\n   174\t  let data;\n   175\t  try {\n   176\t    data = JSON.parse(raw);\n   177\t  } catch (err) {\n   178\t    console.error(`validate-content: ${contentPath} is not valid JSON: ${err.message}`);\n   179\t    process.exit(1);\n   180\t  }\n   181\t\n   182\t  if (!Array.isArray(data.modules)) {\n   183\t    console.error('validate-content: content.json has no \"modules\" array.');\n   184\t    process.exit(1);\n   185\t  }\n   186\t\n   187\t  const ids = new Set(data.modules.map((m) => m && m.id).filter(Boolean));\n   188\t  const errors = [];\n   189\t\n   190\t  for (const m of data.modules) {\n   191\t    const where = m && m.id ? `module ${m.id}` : \"module <unknown>\";\n   192\t\n   193\t    if (!m || typeof m !== \"object\") {\n   194\t      errors.push(`${where}: not an object`);\n   195\t      continue;\n   196\t    }\n   197\t\n   198\t    if (!ALLOWED_TRACKS.has(m.track)) {\n   199\t      errors.push(`${where}: track must be one of ${[...ALLOWED_TRACKS].join(\", \")} (got ${JSON.stringify(m.track)})`);\n   200\t    }\n   201\t\n   202\t    if (!ALLOWED_AUDIENCES.has(m.targetAudience)) {\n   203\t      errors.push(`${where}: targetAudience must be one of ${[...ALLOWED_AUDIENCES].join(\", \")} (got ${JSON.stringify(m.targetAudience)})`);\n   204\t    }\n   205\t\n   206\t    if (typeof m.ajami_validated !== \"boolean\") {\n   207\t      errors.push(`${where}.ajami_validated: must be a boolean.`);\n   208\t    }\n   209\t    const ajamiValidated = m.ajami_validated === true;\n   210\t\n   211\t    validateRootBilingualPair(errors, `${where}.titleHa`, m.titleHa, m.titleAjami, ajamiValidated, Object.hasOwn(m, \"titleAjami\"));\n   212\t    if (m.title != null) validateBilingualObject(errors, `${where}.title`, m.title, ajamiValidated, true);\n   213\t    if (m.summary != null) validateBilingualObject(errors, `${where}.summary`, m.summary, ajamiValidated, true);\n   214\t    validateRootBilingualPair(errors, `${where}.textExplanationHa`, m.textExplanationHa, m.textExplanationAjami, ajamiValidated, Object.hasOwn(m, \"textExplanationAjami\"));\n   215\t\n   216\t    if (m.track === \"vocational\" && m.targetAudience === \"adult\") {\n   217\t      validateAdultVocationalModule(errors, m, where);\n   218\t    }\n   219\t\n   220\t    if (m.track === \"formal\") {\n   221\t      validateSegments(errors, m, where);\n   222\t    } else if (m.segments != null) {\n   223\t      validateSegments(errors, m, where);\n   224\t    }\n   225\t\n   226\t    const hasChainNext = m.chainNext != null && m.chainNext !== \"\";\n   227\t    const isLeaf = m.isChainLeaf === true;\n   228\t\n   229\t    if (!hasChainNext && !isLeaf) {\n   230\t      errors.push(`${where}: no chainNext and not marked isChainLeaf. Either set chainNext to a sibling module id or set isChainLeaf: true.`);\n   231\t    }\n   232\t\n   233\t    if (hasChainNext && isLeaf) {\n   234\t      errors.push(`${where}: has chainNext but is also marked isChainLeaf: true. Pick one.`);\n   235\t    }\n   236\t\n   237\t    if (hasChainNext && !ids.has(m.chainNext)) {\n   238\t      errors.push(`${where}: chainNext \"${m.chainNext}\" does not match any known module id.`);\n   239\t    }\n   240\t\n   241\t    if (hasChainNext && m.chainNext === m.id) {\n   242\t      errors.push(`${where}: chainNext points to itself.`);\n   243\t    }\n   244\t\n   245\t    if (hasChainNext) {\n   246\t      validateBilingualObject(errors, `${where}.gapTeaser`, m.gapTeaser, ajamiValidated, true);\n   247\t    } else if (m.gapTeaser != null) {\n   248\t      validateBilingualObject(errors, `${where}.gapTeaser`, m.gapTeaser, ajamiValidated, false);\n   249\t    }\n   250\t\n   251\t    if (m.useTodayPrompt != null) {\n   252\t      validateBilingualObject(errors, `${where}.useTodayPrompt`, m.useTodayPrompt, ajamiValidated, false);\n   253\t    }\n   254\t\n   255\t    if (m.gapTeaserInline != null) {\n   256\t      validateBilingualObject(errors, `${where}.gapTeaserInline`, m.gapTeaserInline, ajamiValidated, false);\n   257\t    }\n   258\t  }\n   259\t\n   260\t  if (errors.length > 0) {\n   261\t    console.error(`validate-content: ${errors.length} error(s) in ${contentPath}:`);\n   262\t    for (const e of errors) {\n   263\t      console.error(\"  - \" + e);\n   264\t    }\n   265\t    process.exit(1);\n   266\t  }\n   267\t\n   268\t  const leaves = data.modules.filter((m) => m.isChainLeaf === true).length;\n   269\t  const chained = data.modules.filter((m) => m.chainNext != null && m.chainNext !== \"\").length;\n   270\t  const vocational = data.modules.filter((m) => m.track === \"vocational\").length;\n   271\t  const formal = data.modules.filter((m) => m.track === \"formal\").length;\n   272\t\n   273\t  console.log(`validate-content: OK — ${data.modules.length} module(s) pass.`);\n   274\t  console.log(`  track=vocational: ${vocational}`);\n   275\t  console.log(`  track=formal:     ${formal}`);\n   276\t  console.log(`  isChainLeaf:      ${leaves}`);\n   277\t  console.log(`  chainNext set:    ${chained}`);\n   278\t  process.exit(0);\n   279\t}\n   280\t\n   281\tmain();\n","exit_code":0,"status":"completed"}}
