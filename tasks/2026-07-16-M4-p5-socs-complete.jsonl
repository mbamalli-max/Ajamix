     \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"malami kaɗai\",\n          \"yara kaɗai\",\n          \"ba kowa ba\"\n        ]\n      }\n    ],\n    \"track\": \"formal\",\n    \"targetAudience\": \"youth\",\n    \"gapTeaser\": null,\n    \"chainNext\": null,\n    \"isChainLeaf\": true,\n    \"useTodayPrompt\": null\n  },\n  {\n    \"id\": \"p2-socs-15\",\n    \"gradeband\": \"p2\",\n    \"subject\": \"Social Studies\",\n    \"subjectHa\": \"Nazarin Zamantakewa\",\n    \"moduleNumber\": 15,\n    \"titleEn\": \"Keeping the Community Clean\",\n    \"titleHa\": \"Tsaftace Al’umma\",\n    \"titleAjami\": null,\n    \"ajami_validated\": false,\n    \"textExplanationHa\": \"Tsaftace al’umma yana nufin kula da wuraren da jama’a suke amfani da su, kamar hanya, makaranta, kasuwa, filin wasa, da wurin ruwa. Idan al’umma ta kasance da tsafta, mutane za su fi samun lafiya da jin daɗi. Yaro zai iya taimakawa ta hanyar zuba shara a kwandon shara, ɗaukar nasa takarda bayan cin abu, da tunatar da ƙani cikin ladabi. Manyan mutane na iya tsara ranar tsafta, share hanya, ko gyara magudanar ruwa. Kada ka zubar da shara a rijiya, hanya, ko gaban gida. Kada ka ƙone shara kusa da yara. Ka wanke hannu bayan aikin tsafta. Tsaftace al’umma yana bukatar haɗin kai, ba mutum ɗaya kaɗai ba. Idan kowa ya yi nasa ɓangare, unguwa za ta fi kyau da lafiya.\",\n    \"textExplanationAjami\": null,\n    \"audioScript\": \"[INTRO] Sannu da zuwa darasin Zamantakewa. Yau za mu koyi Tsaftace Al’umma. [MAIN] Tsaftace al’umma yana nufin kula da wuraren da jama’a suke amfani da su, kamar hanya, makaranta, kasuwa, filin wasa, da wurin ruwa. Idan al’umma ta kasance da tsafta, mutane za su fi samun lafiya da jin daɗi. Yaro zai iya taimakawa ta hanyar zuba shara a kwandon shara, ɗaukar nasa takarda bayan cin abu, da tunatar da ƙani cikin ladabi. Manyan mutane na iya tsara ranar tsafta, share hanya, ko gyara magudanar ruwa. [PAUSE 1] Me tsaftace al’umma yake nufi? [MAIN] Ka haɗa darasin da abin da kake gani a gida, makaranta, kasuwa, ko unguwa. Ka yi tunani a hankali, ka nuna ladabi, sannan ka tambayi babba idan kana bukatar ƙarin bayani. [PAUSE 2] Me ya kamata ka yi bayan aikin tsafta? [OUTRO] Ka ci gaba da lura da rayuwar al’umma. Kyakkyawan hali yana taimaka maka ka zauna lafiya da mutane.\",\n    \"audioFile\": \"audio/p2-socs-15.mp3\",\n    \"imageCard\": \"images/p2-socs-15.png\",\n    \"microPauses\": [\n      {\n        \"pauseAtMs\": 90000,\n        \"questionHa\": \"Me tsaftace al’umma yake nufi?\",\n        \"correctAnswer\": \"kula da wuraren jama’a\",\n        \"options\": [\n          \"kula da wuraren jama’a\",\n          \"ɓoye shara\",\n          \"lalata hanya\"\n        ]\n      },\n      {\n        \"pauseAtMs\": 150000,\n        \"questionHa\": \"Me ya kamata ka yi bayan aikin tsafta?\",\n        \"correctAnswer\": \"wanke hannu\",\n        \"options\": [\n          \"wanke hannu\",\n          \"ci abinci nan da nan\",\n          \"taɓa fuska\"\n        ]\n      }\n    ],\n    \"quizQuestions\": [\n      {\n        \"templateHa\": \"Me tsaftace al’umma yake nufi?\",\n        \"answerFormula\": \"kula da wuraren jama’a\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"ɓoye shara\",\n          \"lalata hanya\",\n          \"ƙin taimako\"\n        ]\n      },\n      {\n        \"templateHa\": \"Ina ya kamata a zuba shara?\",\n        \"answerFormula\": \"kwandon shara\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"rijiya\",\n          \"hanya\",\n          \"gaban gida\"\n       