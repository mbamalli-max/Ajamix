N.stringify(m.microPauses[p].questionHa)}`);\n   const n=m.microPauses[p].options.filter(x=>x===m.microPauses[p].correctAnswer).length;\n   if(n!==1) errs.push(`${m.id} pause${p+1} answer count ${n}`);\n }\n const taught=(m.textExplanationHa+'\"' '+m.audioScript).normalize('NFC').toLocaleLowerCase('ha');\n for(let q=0;q<5;q++){\n   const x=m.quizQuestions[q];\n   if(x.distractorFormulas.includes(x.answerFormula)) errs.push(\"'`${m.id} q${q+1} answer in distractors`);\n   if(!taught.includes(x.answerFormula.normalize('\"'NFC').toLocaleLowerCase('ha'))) errs.push(\"'`${m.id} q${q+1} ungrounded literal: ${x.answerFormula}`);\n   if(JSON.stringify(x.variableRanges)!==JSON.stringify({a:{min:0,max:0},b:{min:0,max:0}})) errs.push(`${m.id} q${q+1} ranges`);\n }\n}\nconst q5=d.map(m=>m.quizQuestions[4].templateHa), outros=d.map(m=>m.audioScript.split('\"'[OUTRO] ')[1]);\nif(new Set(q5).size\"'!==15) errs.push('\"'duplicate Q5'); if(new Set(outros).size\"'!==15) errs.push('\"'duplicate OUTRO');\nconst mk=['id','imagePath','titleEn','titleHa','type','depictEn','labelsHa','safetyNote'];\nif(man.length\"'!==15) errs.push('\"'manifest count');\nfor(let i=0;i<man.length;i++){const x=man[i],m=d[i]; if(JSON.stringify(Object.keys(x))\"'!==JSON.stringify(mk)) errs.push(`${x.id} manifest keys`); if(x.id!==m.id||x.imagePath!==m.imageCard||x.titleEn!==m.titleEn||x.titleHa!==m.titleHa) errs.push(`${x.id} manifest alignment`);}\nconsole.log('\"'word counts',w.map(x=>x.join('=')).join(', '));\nconsole.log('min/max',Math.min(...w.map(x=>x[1])),Math.max(...w.map(x=>x[1])));\nconsole.log('errors',errs.length); errs.forEach(e=>console.log('ERROR',e));\nprocess.exitCode=errs.length?1:0;\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
