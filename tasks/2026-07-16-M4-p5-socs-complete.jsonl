\": \"youth\",\n    \"gapTeaser\": null,\n    \"chainNext\": null,\n    \"isChainLeaf\": true,\n    \"useTodayPrompt\": null\n  },\n  {\n    \"id\": \"p2-socs-08\",\n    \"gradeband\": \"p2\",\n    \"subject\": \"Social Studies\",\n    \"subjectHa\": \"Nazarin Zamantakewa\",\n    \"moduleNumber\": 8,\n    \"titleEn\": \"Rules at Home and School\",\n    \"titleHa\": \"Dokoki a Gida da Makaranta\",\n    \"titleAjami\": null,\n    \"ajami_validated\": false,\n    \"textExplanationHa\": \"Dokoki su ne ƙa’idoji da suke taimaka wa mutane su zauna lafiya cikin tsari. A gida, iyaye na iya cewa ka wanke hannu kafin cin abinci, ka dawo da kaya wurinsu, ko ka yi magana cikin ladabi. A makaranta, malamai na iya cewa ka zo da wuri, ka saurara a aji, ka ɗaga hannu kafin magana, kuma ka kula da littafi. Dokoki ba don tsoro kawai ba ne; suna kare ka da sauran mutane. Idan babu doka, mutane za su yi abin da suka ga dama, sai hayaniya da matsala su ƙaru. Ka bi doka cikin natsuwa, ka tambayi babba idan ba ka gane ba. Yaro mai bin doka yana samun aminci, ilimi, da girmamawa daga mutane. Ka sake duba misali a gida ko makaranta, sannan ka faɗa wa babba abin da ka koya.\",\n    \"textExplanationAjami\": null,\n    \"audioScript\": \"[INTRO] Sannu da zuwa darasin Zamantakewa. Yau za mu koyi Dokoki a Gida da Makaranta. [MAIN] Dokoki su ne ƙa’idoji da suke taimaka wa mutane su zauna lafiya cikin tsari. A gida, iyaye na iya cewa ka wanke hannu kafin cin abinci, ka dawo da kaya wurinsu, ko ka yi magana cikin ladabi. A makaranta, malamai na iya cewa ka zo da wuri, ka saurara a aji, ka ɗaga hannu kafin magana, kuma ka kula da littafi. Dokoki ba don tsoro kawai ba ne; suna kare ka da sauran mutane. [PAUSE 1] Me dokoki suke taimakawa a gida da makaranta? [MAIN] Ka haɗa darasin da abin da kake gani a gida, makaranta, kasuwa, ko unguwa. Ka yi tunani a hankali, ka nuna ladabi, sannan ka tambayi babba idan kana bukatar ƙarin bayani. [PAUSE 2] Me ya kamata ka yi kafin magana a aji? [OUTRO] Ka ci gaba da lura da rayuwar al’umma. Kyakkyawan hali yana taimaka maka ka zauna lafiya da mutane.\",\n    \"audioFile\": \"audio/p2-socs-08.mp3\",\n    \"imageCard\": \"images/p2-socs-08.png\",\n    \"microPauses\": [\n      {\n        \"pauseAtMs\": 90000,\n        \"questionHa\": \"Me dokoki suke taimakawa a gida da makaranta?\",\n        \"correctAnswer\": \"tsari\",\n        \"options\": [\n          \"tsari\",\n          \"hayaniya\",\n          \"rashin ladabi\"\n        ]\n      },\n      {\n        \"pauseAtMs\": 150000,\n        \"questionHa\": \"Me ya kamata ka yi kafin magana a aji?\",\n        \"correctAnswer\": \"ɗaga hannu\",\n        \"options\": [\n          \"ɗaga hannu\",\n          \"yin ihu\",\n          \"barin aji\"\n        ]\n      }\n    ],\n    \"quizQuestions\": [\n      {\n        \"templateHa\": \"Me dokoki suke taimakawa a gida da makaranta?\",\n        \"answerFormula\": \"tsari\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"hayaniya\",\n          \"rashin ladabi\",\n          \"faɗa\"\n        ]\n      },\n      {\n        \"templateHa\": \"Me ya kamata ka yi kafin magana a aji?\",\n        \"answerFormula\": \"ɗaga hannu\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"yin ihu\",\n          \"barin aji\",\n          \"buga teburi\"\n        ]\n      },\n      {\n        \"templateHa\": \"Wane doka ce ta gida?\",\n        \"answerFormula\": \"wanke hannu kafin abinci\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n   