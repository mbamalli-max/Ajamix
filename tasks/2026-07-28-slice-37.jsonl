{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, hashlib\nfrom pathlib import Path\nfrom fontTools.ttLib import TTFont\nroot=Path('tools/ajami-pipeline/fonts/harmattan-4.400')\nfor p in sorted(root.glob('*.woff2')):\n    f=TTFont(p)\n    names=f['name']\n    def name(nid):\n        vals=[]\n        for n in names.names:\n            if n.nameID==nid:\n                try: v=n.toUnicode()\n                except: continue\n                if v not in vals: vals.append(v)\n        return vals\n    os2=f['OS/2']; head=f['head']; hhea=f['hhea']; maxp=f['maxp']\n    d={\n      'file':p.name,'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'bytes':p.stat().st_size,\n      'familyNameId1':name(1),'subfamilyNameId2':name(2),'fullNameId4':name(4),'versionNameId5':name(5),'typographicFamilyNameId16':name(16),'typographicSubfamilyNameId17':name(17),\n      'head':{'unitsPerEm':head.unitsPerEm,'fontRevision':head.fontRevision,'flags':head.flags,'macStyle':head.macStyle,'xMin':head.xMin,'yMin':head.yMin,'xMax':head.xMax,'yMax':head.yMax,'lowestRecPPEM':head.lowestRecPPEM},\n      'OS2':{'version':os2.version,'usWeightClass':os2.usWeightClass,'usWidthClass':os2.usWidthClass,'fsType':os2.fsType,'fsSelection':os2.fsSelection,'sTypoAscender':os2.sTypoAscender,'sTypoDescender':os2.sTypoDescender,'sTypoLineGap':os2.sTypoLineGap,'usWinAscent':os2.usWinAscent,'usWinDescent':os2.usWinDescent,'sxHeight':getattr(os2,'sxHeight',None),'sCapHeight':getattr(os2,'sCapHeight',None),'ulUnicodeRange1':os2.ulUnicodeRange1,'ulUnicodeRange2':os2.ulUnicodeRange2,'ulUnicodeRange3':os2.ulUnicodeRange3,'ulUnicodeRange4':os2.ulUnicodeRange4,'achVendID':os2.achVendID},\n      'hhea':{'ascent':hhea.ascent,'descent':hhea.descent,'lineGap':hhea.lineGap,'advanceWidthMax':hhea.advanceWidthMax},\n      'glyphs':maxp.numGlyphs,'tables':sorted(f.keys())\n    }\n    print(json.dumps(d,ensure_ascii=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
