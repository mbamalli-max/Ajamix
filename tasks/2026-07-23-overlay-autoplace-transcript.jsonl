exclusiveMinimum\": 0 } } },\n    \"line\": { \"type\": \"object\", \"required\": [\"x1\", \"y1\", \"x2\", \"y2\"], \"properties\": { \"x1\": { \"type\": \"number\" }, \"y1\": { \"type\": \"number\" }, \"x2\": { \"type\": \"number\" }, \"y2\": { \"type\": \"number\" }, \"arrow\": { \"type\": \"boolean\" } } },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"mode\", \"box\", \"font\", \"lines\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"mode\": { \"enum\": [\"latin\", \"ajami\", \"bilingual\"] },\n        \"box\": { \"$ref\": \"#/$defs/box\" },\n        \"font\": { \"type\": \"object\", \"required\": [\"latinFamily\", \"ajamiFamily\", \"size\"], \"properties\": { \"latinFamily\": { \"type\": \"string\" }, \"ajamiFamily\": { \"type\": \"string\" }, \"size\": { \"type\": \"number\", \"minimum\": 8 }, \"lineHeight\": { \"type\": \"number\", \"minimum\": 1 } } },\n        \"lines\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2, \"items\": { \"type\": \"object\", \"required\": [\"script\", \"text\"], \"properties\": { \"script\": { \"enum\": [\"latin\", \"ajami\", \"math\"] }, \"text\": { \"type\": \"string\" }, \"direction\": { \"enum\": [\"ltr\", \"rtl\"] }, \"validated\": { \"type\": \"boolean\" }, \"columnLines\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } } },\n        \"callout\": { \"$ref\": \"#/$defs/line\" },\n        \"background\": { \"type\": \"string\" }, \"foreground\": { \"type\": \"string\" }, \"mobileSafe\": { \"type\": \"boolean\" }\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
