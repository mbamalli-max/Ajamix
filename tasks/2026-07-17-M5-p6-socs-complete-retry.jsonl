 \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"raina su\",\n          \"tsokane su\",\n          \"ɓata musu kaya\"\n        ]\n      }\n    ],\n    \"track\": \"formal\",\n    \"targetAudience\": \"youth\",\n    \"gapTeaser\": null,\n    \"chainNext\": null,\n    \"isChainLeaf\": true,\n    \"useTodayPrompt\": null\n  },\n  {\n    \"id\": \"p2-socs-07\",\n    \"gradeband\": \"p2\",\n    \"subject\": \"Social Studies\",\n    \"subjectHa\": \"Nazarin Zamantakewa\",\n    \"moduleNumber\": 7,\n    \"titleEn\": \"The Market\",\n    \"titleHa\": \"Kasuwa\",\n    \"titleAjami\": null,\n    \"ajami_validated\": false,\n    \"textExplanationHa\": \"Kasuwa wuri ne da mutane suke saye da sayarwa. A kasuwa za ka iya ganin kayan abinci kamar shinkafa, wake, tumatir, albasa, da kayan miya. Za ka iya ganin tufafi, takalma, littattafai, ko kayan gida. Masu sayarwa suna nuna kaya, masu saya kuma suna tambayar farashi. Idan ka je kasuwa da babba, ka tsaya kusa da shi, ka saurara, kada ka yi gudu a cikin cunkoso. Kuɗi yana da muhimmanci a kasuwa, don haka a kula da shi. Ka yi magana cikin ladabi idan kana tambayar farashi. Kada ka taɓa kayan mutum ba tare da izini ba. Kasuwa tana taimaka wa al’umma saboda mutane suna samun abin da suke bukata, kuma masu sana’a suna samun kuɗin shiga. Ka sake duba misali a gida ko makaranta, sannan ka faɗa wa babba abin da ka koya.\",\n    \"textExplanationAjami\": null,\n    \"audioScript\": \"[INTRO] Sannu da zuwa darasin Zamantakewa. Yau za mu koyi Kasuwa. [MAIN] Kasuwa wuri ne da mutane suke saye da sayarwa. A kasuwa za ka iya ganin kayan abinci kamar shinkafa, wake, tumatir, albasa, da kayan miya. Za ka iya ganin tufafi, takalma, littattafai, ko kayan gida. Masu sayarwa suna nuna kaya, masu saya kuma suna tambayar farashi. [PAUSE 1] Ina ake saye da sayarwa? [MAIN] Ka haɗa darasin da abin da kake gani a gida, makaranta, kasuwa, ko unguwa. Ka yi tunani a hankali, ka nuna ladabi, sannan ka tambayi babba idan kana bukatar ƙarin bayani. [PAUSE 2] Me ake tambaya kafin saye? [OUTRO] Ka ci gaba da lura da rayuwar al’umma. Kyakkyawan hali yana taimaka maka ka zauna lafiya da mutane.\",\n    \"audioFile\": \"audio/p2-socs-07.mp3\",\n    \"imageCard\": \"images/p2-socs-07.png\",\n    \"microPauses\": [\n      {\n        \"pauseAtMs\": 90000,\n        \"questionHa\": \"Ina ake saye da sayarwa?\",\n        \"correctAnswer\": \"kasuwa\",\n        \"options\": [\n          \"kasuwa\",\n          \"asibiti\",\n          \"ƙofar gida\"\n        ]\n      },\n      {\n        \"pauseAtMs\": 150000,\n        \"questionHa\": \"Me ake tambaya kafin saye?\",\n        \"correctAnswer\": \"farashi\",\n        \"options\": [\n          \"farashi\",\n          \"launin sama\",\n          \"sunan kogi\"\n        ]\n      }\n    ],\n    \"quizQuestions\": [\n      {\n        \"templateHa\": \"Ina ake saye da sayarwa?\",\n        \"answerFormula\": \"kasuwa\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"asibiti\",\n          \"ƙofar gida\",\n          \"filin wasa\"\n        ]\n      },\n      {\n        \"templateHa\": \"Me ake tambaya kafin saye?\",\n        \"answerFormula\": \"farashi\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"launin sama\",\n          \"sunan kogi\",\n          \"adadin taurari\"\n        ]\n      },\n      {\n        \"templateHa\": \"Me ya kamata ka yi idan ka je kasuwa da babba?\",\n        \"answerFormula\": \"tsaya kusa da shi\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"gudu cikin cunkoso\",\n          \"ɓacewa\",\n          \"taɓa kaya ba izini\"\n        ]\n      },\n      {\n        \"templateHa\": \"Wane abu ake amfani da shi wajen saye?\",\n        \"answerFormula\": \"kuɗi\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"ƙura\",\n          \"ganye\",\n          \"toka\"\n        ]\n      },\n      {\n        \"templateHa\": \"Me kasuwa take taimaka wa mutane su samu?\",\n        \"answerFormula\": \"abin da suke bukata\",\n        \"variableRanges\": {\n          \"a\": {\n            \"min\": 0,\n            \"max\": 0\n          },\n          \"b\": {\n            \"min\": 0,\n            \"max\": 0\n          }\n        },\n        \"distractorFormulas\": [\n          \"hayaniya kawai\",\n          \"faɗa\",\n          \"rashin tsari\"\n        ]\n      }\n    ],\n    \"track\": \"formal\",\n    \"targetAudience\": \"youth\",\n    \"gapTeaser\": null,\n    \"chainNext\": null,\n    \"isChainLeaf\": true,\n    \"useTodayPrompt\": null\n  },\n  {\n    \"id\": \"p2-socs-08\",\n    \"gradeband\": \"p2\",\n    \"subject\": \"Social Studies\",\n    \"subjectHa\": \"Nazarin Zamantakewa\",\n    \"moduleNumber\": 8,\n    \"titleEn\": \"Rules at Home and School\",\n    \"titleHa\": \"Dokoki a Gida da Makaranta\",\n    \"titleAjami\": null,\n    \"ajami_validated\": false,\n    \"textExplanationHa\": \"Dokoki su ne ƙa’idoji da suke taimaka wa mutane su zauna lafiya cikin tsari. A gida, iyaye na iya cewa ka wanke hannu kafin cin abinci, ka dawo da kaya wurinsu, ko ka yi magana cikin ladabi. A makaranta, malamai na iya cewa ka zo da wuri, ka saurara a aji, ka ɗaga hannu kafin magana, kuma ka kula da littafi. Dokoki ba don tsoro kawai ba ne; suna kare ka da sauran mutane. Idan babu doka, mutane za su yi abin da suka ga dama, sai hayaniya da matsala su ƙaru. Ka bi doka cikin natsuwa, ka tambayi babba idan ba ka gane ba. Yaro mai bin doka yana samun aminci, ilimi, da girmamawa daga mutane. Ka sake duba misali a gida ko makaranta, sannan ka faɗa wa babba abin da ka koya.\",\n    \"textExplanationAjami\": null,\n    \"audioScript\": \"[INTRO] Sannu da zuwa darasin Zamantakewa. Yau za mu koyi Dokoki a Gida da Makaranta. [MAIN] Dokoki su ne ƙa’idoji da suke taimaka wa mutane su zauna lafiya cikin tsari. A gida, iyaye na iya cewa ka wanke hannu kafin cin abinci, ka dawo da kaya wurinsu, ko ka yi magana cikin ladabi. A makaranta, malamai na iya cewa ka zo da wuri, ka saurara a aji, ka ɗaga hannu kafin magana, kuma ka kula da littafi. Dokoki ba don tsoro kawai ba ne; suna kare ka da sauran mutane. [PAUSE 1] Me dokoki suke taimakawa a gida da makaranta? [MAIN] Ka haɗa darasin da abin da kake gani a gida, makaranta, kasuwa, ko unguwa. Ka yi tunani a hankali, ka nuna ladabi, sannan ka tambayi babba idan kana bukatar ƙarin bayani. [PAUSE 2] Me ya kamata ka yi kafin magana a aji? [OUTRO] Ka ci gaba da lura da rayuwar al’umma. Kyakkyawan hali yana taimaka maka ka zauna lafiya da mutane.\",\n    \"audioFile\": \"audio/p2-socs-08.mp3\",\n    \"imageCard\": \"images/p2-socs-08.png\",\n    \"microPauses\": [\n      {\n        \"pauseAtMs\": 90000,\n        \"questionHa\": \"Me dokoki suke taimakawa a gida da makaranta?\",\n        \"correctAnswer\": \"tsari\",\n        \"options\": [\n          \"tsari\",\n          \"hayaniya\",\n          \"rashin ladabi\"\n        ]\n      },\n      {\n        \"pauseAtMs\": 150000,\n        \"questionHa\": \"Me ya kamata ka yi kafin magana a aji?\",\n        \"correctAnswer\": \"ɗaga hannu\",\n        \"options\": [\n          \"ɗaga hannu\",\n          \"yin ihu\",\n          \"barin aji\"\n      