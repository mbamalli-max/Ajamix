{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' tools/p1-batch/check-within-module-redundancy.mjs\"","aggregated_output":"#!/usr/bin/env node\nimport fs from 'node:fs';\nimport { pathToFileURL } from 'node:url';\n\nconst contentPath = new URL('../../app/content.json', import.meta.url);\nconst idsArg = process.argv.find((argument) => argument.startsWith('--ids='));\nconst fileArg = process.argv.find((argument) => argument.startsWith('--file='));\nconst requestedIds = idsArg ? new Set(idsArg.slice('--ids='.length).split(',').filter(Boolean)) : null;\n\nconst normalize = (sentence) => sentence\n  .normalize('NFC')\n  .toLocaleLowerCase('ha')\n  .replace(/[“”'’]/g, \"'\")\n  .replace(/[^\\p{L}\\p{N}]+/gu, ' ')\n  .trim()\n  .replace(/\\s+/g, ' ');\n\n// A period between two digits (e.g. \"3.45\", \"0.5\") is a decimal point, not a\n// sentence boundary. Protect it with a control-character placeholder (never\n// legitimately present in learner-facing text) before splitting on genuine\n// sentence-ending punctuation, then restore it afterward. This keeps decimal\n// numbers intact without suppressing real sentence boundaries elsewhere.\nconst DECIMAL_PLACEHOLDER = '\u0000';\nconst protectDecimals = (text) => text.replace(/(\\d)\\.(\\d)/g, `$1${DECIMAL_PLACEHOLDER}$2`);\nconst restoreDecimals = (text) => text.split(DECIMAL_PLACEHOLDER).join('.');\n\nexport const sentences = (text) => (protectDecimals(text).match(/[^.!?]+[.!?]+|[^.!?]+$/g) ?? [])\n  .map((item) => restoreDecimals(item.trim()))\n  .filter(Boolean);\n\nexport function findRedundancy(modules) {\n  const findings = [];\n  for (const module of modules) {\n    const seen = new Map();\n    const moduleSentences = sentences(module.textExplanationHa);\n    for (const [index, sentence] of moduleSentences.entries()) {\n      const key = normalize(sentence);\n      if (seen.has(key)) findings.push(`${module.id}: normalized duplicate sentences ${seen.get(key) + 1} and ${index + 1}`);\n      else seen.set(key, index);\n    }\n    for (let index = 1; index < moduleSentences.length; index += 1) {\n      const previous = normalize(moduleSentences[index - 1]);\n      const current = normalize(moduleSentences[index]);\n      if (previous && current && (previous.includes(current) || current.includes(previous))) {\n        findings.push(`${module.id}: adjacent containment duplication ${index} and ${index + 1}`);\n      }\n    }\n  }\n  return findings;\n}\n\nconst isMainModule = process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href;\nif (isMainModule) {\n  const input = JSON.parse(fs.readFileSync(fileArg ? fileArg.slice('--file='.length) : contentPath, 'utf8'));\n  const allModules = Array.isArray(input) ? input : input.modules;\n  if (!Array.isArray(allModules)) throw new Error('Input must be a module array or an object with a modules array.');\n  const modules = requestedIds ? allModules.filter((module) => requestedIds.has(module.id)) : allModules;\n  if (requestedIds && modules.length !== requestedIds.size) {\n    const foundIds = new Set(modules.map((module) => module.id));\n    throw new Error(`Unknown module ids: ${[...requestedIds].filter((id) => !foundIds.has(id)).join(', ')}`);\n  }\n\n  const findings = findRedundancy(modules);\n  if (findings.length) {\n    console.error(`Within-module redundancy check failed (${findings.length} finding(s)):`);\n    for (const finding of findings) console.error(`- ${finding}`);\n    process.exitCode = 1;\n  } else {\n    console.log(`Within-module redundancy check passed for ${modules.length} module(s).`);\n  }\n}\n","exit_code":0,"status":"completed"}}
